# ==============================================================================
# RepoPilot Runtime Configuration (.env.example)
# Copy to .env.local for local development. Do NOT commit real secrets.
# ==============================================================================

# GitHub API Configuration (Optional: increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Gemma / OpenAI-Compatible Inference Provider Configuration
# Examples:
#   Groq:
#     GEMMA_API_BASE_URL=https://api.groq.com/openai/v1
#     GEMMA_MODEL=gemma2-9b-it
#     GEMMA_API_KEY=gsk_...
#   OpenRouter:
#     GEMMA_API_BASE_URL=https://openrouter.ai/api/v1
#     GEMMA_MODEL=google/gemma-2-9b-it
#     GEMMA_API_KEY=sk-or-...
#   Local Ollama:
#     GEMMA_API_BASE_URL=http://localhost:11434/v1
#     GEMMA_MODEL=gemma2:9b
#     GEMMA_API_KEY=ollama
GEMMA_API_BASE_URL=https://api.groq.com/openai/v1
GEMMA_API_KEY=your_api_key_here
GEMMA_MODEL=gemma2-9b-it

# Bounded Provider Timeout (milliseconds, default: 30000)
AI_REQUEST_TIMEOUT_MS=30000

# Ingestion Bounded Context Limits
MAX_REPOSITORY_FILES=25
MAX_FILE_BYTES=49152
MAX_CONTEXT_CHARS=120000

# Rate Limiting (Requests per 60-second window per IP)
MAX_REQUESTS_PER_WINDOW=30

